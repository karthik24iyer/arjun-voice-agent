# Copy to ~/.config/arjun/arjun.env (loaded by arjun.service). All settings are optional.
# Physical mic, used directly when the output is headphones (`pactl list short sources`):
ARJUN_RAW_MIC=
# Echo-cancelled mic from 60-arjun-echo-cancel.conf, used with speakers:
#ARJUN_MIC=arjun_ec_source
#ARJUN_WAKE_NAME=arjun
#ARJUN_DUPLEX=half
#ARJUN_LIVE_IDLE_SECONDS=20
#ARJUN_VOICE_MODEL=anthropic/claude-sonnet-5-5 --runtime openclaw
